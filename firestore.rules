rules_version = '2';

// Futsal booking — Firestore Security Rules.
//
// SPARK PLAN: there are NO Cloud Functions. These rules are the ONLY line of
// defence; the client is never trusted. Design + rationale:
// docs/architecture/firestore_schema.md.
//
// ROLES live in users/{uid}: role ('superadmin' | 'shopAdmin' | 'customer'),
// shopId (string | null) and isActive (bool). A user can create only their
// own doc, only as an active customer, and can never change role / shopId /
// isActive. Only a superadmin changes those, and never on their own doc.
// Custom claims are NOT used.
//
// BOOKINGS use slot lock docs: stadiums/{sid}/courts/{cid}/slots/{date}_{mmmm}.
// A booking is created in ONE atomic request together with one slot doc per
// slot it covers. Slot docs can be created only if they do not exist yet and
// can never be updated, so a second request touching a taken slot is refused
// and the whole batch/transaction fails: double booking is impossible, even
// under concurrency. MAX_SLOTS_PER_BOOKING = 4 (unrolled below; mirror of
// BookingPolicy.maxSlotsPerBooking in lib/core/constants/booking_policy.dart).
//
// Default deny: every collection not matched below is closed.
//
// LIST QUERIES: rules are not filters. A query is allowed only if the rule
// holds for every document it could return, so client queries must carry
// the matching constraint:
//   stadiums  -> where('isPublished', '==', true)          (customers)
//             -> where('shopId', '==', users/{uid}.shopId) (shop admins)
//   courts    -> where('isActive', '==', true)             (customers)
//                (admins of the stadium's shop: no filter needed)
//   shops, users -> any query                              (superadmin)
//   bookings  -> where('customerId', '==', auth.uid)       (customers)
//             -> where('shopId', '==', users/{uid}.shopId) (shop admins)
//   blocked_slots -> where('shopId', '==', users/{uid}.shopId)
//   notifications -> where('audience', '==', 'customer')
//                    + where('recipientId', '==', auth.uid)    (customers)
//                 -> where('audience', '==', 'shop')
//                    + where('recipientId', '==', users/{uid}.shopId)
//   shops/{shopId}/blacklist -> admins of that shop / superadmin only
//   announcements -> any query (superadmin); others filter on audience
//   players   -> any query (active users; single-doc reads today)
// Queries live in lib/firebase/firestore/*_collection.dart.
//
// DOCUMENT-ACCESS BUDGET (get/exists/getAfter/existsAfter). Limits: 10 per
// single operation, 20 per multi-document request (batch/transaction);
// repeated access to the same document is cached. Worst case, 4-slot
// booking create (1 booking + 4 slot writes):
//   booking op : users/{uid}, court, stadium, shop, exists(blacklist entry),
//                getAfter(slot 0..3)                                      = 9
//   each slot  : users/{uid}, getAfter(booking), exists(booking)          = 3
//   distinct documents in the request                                    = 11
//   (users/{uid} and the booking are shared by every operation, so the
//   cached count stays well under 20)
// Customer cancel / staff reject (1 booking update + 4 slot deletes):
//   booking op : users/{uid}, existsAfter(slot 0..3) = 5; each slot delete:
//   users/{uid}, getAfter(booking) = 2 -> 6 distinct (13 uncached).
// Blocked-slot create (1 block + 4 slots):
//   block op: users/{uid}, court, stadium, getAfter(slot 0..3) = 7; each slot:
//   users/{uid}, getAfter(block) = 2 -> 8 distinct (15 uncached).
service cloud.firestore {
  match /databases/{database}/documents {

    // --- Paths ------------------------------------------------------------

    function userPath(uid) {
      return /databases/$(database)/documents/users/$(uid);
    }

    function shopPath(shopId) {
      return /databases/$(database)/documents/shops/$(shopId);
    }

    function stadiumPath(stadiumId) {
      return /databases/$(database)/documents/stadiums/$(stadiumId);
    }

    function courtPath(stadiumId, courtId) {
      return /databases/$(database)/documents/stadiums/$(stadiumId)/courts/$(courtId);
    }

    function slotPath(stadiumId, courtId, slotId) {
      return /databases/$(database)/documents/stadiums/$(stadiumId)/courts/$(courtId)/slots/$(slotId);
    }

    function bookingPath(bookingId) {
      return /databases/$(database)/documents/bookings/$(bookingId);
    }

    function blockPath(blockedSlotId) {
      return /databases/$(database)/documents/blocked_slots/$(blockedSlotId);
    }

    function blacklistPath(shopId, customerId) {
      return /databases/$(database)/documents/shops/$(shopId)/blacklist/$(customerId);
    }

    // --- Identity / roles (users/{uid}) -----------------------------------

    function signedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // The caller's own users doc. Errors (-> deny) when it does not exist,
    // so a signed-in user without a profile has no role at all.
    function me() {
      return get(userPath(request.auth.uid)).data;
    }

    // Every write (except the one-time self-create of users/{uid}) and every
    // read of personal data requires an active account.
    function isActiveUser() {
      return signedIn() && me().get('isActive', false) == true;
    }

    function role() {
      return me().get('role', '');
    }

    function myShopId() {
      let s = me().get('shopId', null);
      return s is string ? s : '';
    }

    // PLATFORM scope.
    function isSuperadmin() {
      return isActiveUser() && role() == 'superadmin';
    }

    // SHOP scope. A shop admin without a shopId has no shop access.
    function isShopAdmin() {
      return isActiveUser() && role() == 'shopAdmin' && myShopId() != '';
    }

    function isAdminOfShop(shopId) {
      return isShopAdmin() && myShopId() == shopId;
    }

    // CUSTOMER scope.
    function isCustomer() {
      return isActiveUser() && role() == 'customer';
    }

    // --- Shared validators ------------------------------------------------

    // Keep limits in sync with lib/core/utils/validators.dart.
    function validName(v) {
      return v is string && v.size() >= 2 && v.size() <= 80;
    }

    function validPhone(v) {
      return v == null || (v is string && v.size() <= 32);
    }

    // Phase 13 tightens this to a Storage URL under the user's own path.
    function validProfileImage(v) {
      return v == null || (v is string && v.size() <= 2048);
    }

    function validReason(v) {
      return v == null || (v is string && v.size() <= 500);
    }

    // --- Dates, minutes and slot ids --------------------------------------

    function isDateKey(v) {
      return v is string && v.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    // UTC midnight of a yyyy-MM-dd key.
    function dayStart(dateKey) {
      let p = dateKey.split('-');
      return timestamp.date(int(p[0]), int(p[1]), int(p[2]));
    }

    // Rejects keys like 2026-02-30 even if timestamp.date() would roll them
    // over: two spellings of the same day would be two slot namespaces.
    function isRealDate(dateKey) {
      let p = dateKey.split('-');
      let day = dayStart(dateKey);
      return day.year() == int(p[0])
        && day.month() == int(p[1])
        && day.day() == int(p[2]);
    }

    // Myanmar Time = UTC+06:30 (390 minutes), no DST. Only Asia/Yangon
    // stadiums are supported (the booking rule checks stadium.timeZone).
    // Mirror: BookingPolicy.utcOffsetMinutes / LocalTime.instantFor (Dart).
    function localInstant(dateKey, minute) {
      return dayStart(dateKey) + duration.value(minute - 390, 'm');
    }

    // startAt / endAt must be exactly the local date + minutes.
    function validInstants(dateKey, x) {
      return isDateKey(dateKey)
        && isRealDate(dateKey)
        && x.startAt == localInstant(dateKey, x.startMinute)
        && x.endAt == localInstant(dateKey, x.endMinute);
    }

    // Minutes < 1440, so 4 digits. Mirror: SlotKey.of (Dart).
    function pad4(n) {
      return n < 10 ? '000' + string(n)
        : (n < 100 ? '00' + string(n)
        : (n < 1000 ? '0' + string(n) : string(n)));
    }

    // Slot lock doc id, e.g. 2026-10-01_1080.
    function slotKey(dateKey, minute) {
      return dateKey + '_' + pad4(minute);
    }

    function courtSlotMinutes(court) {
      return court.get('slotMinutes', 60);
    }

    // Bookable window: inside opening hours, on the slot grid counted from
    // openMinute, a whole number of slots, 1..MAX_SLOTS_PER_BOOKING (4).
    function validWindow(x, stadium, sm) {
      return sm is int && sm > 0 && sm <= 1440
        && x.slotMinutes == sm
        && x.startMinute is int && x.endMinute is int
        && stadium.openMinute is int && stadium.closeMinute is int
        && stadium.openMinute >= 0 && stadium.closeMinute <= 1440
        && x.startMinute >= stadium.openMinute
        && x.endMinute <= stadium.closeMinute
        && x.endMinute > x.startMinute
        && (x.startMinute - stadium.openMinute) % sm == 0
        && (x.endMinute - x.startMinute) % sm == 0
        && x.endMinute - x.startMinute <= 4 * sm; // MAX_SLOTS_PER_BOOKING
    }

    // --- Slot lock checks (unrolled for MAX_SLOTS_PER_BOOKING = 4) ---------
    // x = a booking or blocked_slots doc (stadiumId, courtId, startMinute,
    // endMinute, slotMinutes). Slot i starts at startMinute + i*slotMinutes
    // and is needed only while that start is before endMinute.

    function slotHeld(x, dateKey, minute, kind, refId) {
      return minute >= x.endMinute
        || slotHeldBy(
             getAfter(slotPath(x.stadiumId, x.courtId, slotKey(dateKey, minute))).data,
             kind, refId);
    }

    function slotHeldBy(s, kind, refId) {
      return s.kind == kind && s.refId == refId;
    }

    // After this request, every slot of x exists and points at refId.
    // (No `!exists(slot)` here: a slot that already existed would be written
    // as an update, which is always denied; and a pre-existing slot cannot
    // point at refId because refId's doc is being created right now.)
    function allSlotsHeld(x, dateKey, kind, refId) {
      return slotHeld(x, dateKey, x.startMinute, kind, refId)
        && slotHeld(x, dateKey, x.startMinute + x.slotMinutes, kind, refId)
        && slotHeld(x, dateKey, x.startMinute + 2 * x.slotMinutes, kind, refId)
        && slotHeld(x, dateKey, x.startMinute + 3 * x.slotMinutes, kind, refId);
    }

    function slotFreed(x, dateKey, minute) {
      return minute >= x.endMinute
        || !existsAfter(slotPath(x.stadiumId, x.courtId, slotKey(dateKey, minute)));
    }

    // After this request, none of x's slot docs exist.
    function allSlotsFreed(x, dateKey) {
      return slotFreed(x, dateKey, x.startMinute)
        && slotFreed(x, dateKey, x.startMinute + x.slotMinutes)
        && slotFreed(x, dateKey, x.startMinute + 2 * x.slotMinutes)
        && slotFreed(x, dateKey, x.startMinute + 3 * x.slotMinutes);
    }

    // --- users/{uid} ------------------------------------------------------

    function userCreateKeys() {
      return ['name', 'email', 'phone', 'profileImage', 'role', 'shopId',
              'isActive', 'createdAt', 'updatedAt'];
    }

    // Self-registration: always an active customer without a shop. The name
    // may be empty only for the recovery path (doc re-created from an Auth
    // user without a display name); the app then asks for it in Profile.
    function validSelfCreate(uid) {
      let d = request.resource.data;
      return isSelf(uid)
        && d.keys().hasOnly(userCreateKeys())
        && d.keys().hasAll(['name', 'email', 'role', 'shopId', 'isActive',
                            'createdAt', 'updatedAt'])
        && d.role == 'customer'
        && d.shopId == null
        && d.isActive == true
        && d.email == request.auth.token.email
        && d.createdAt == request.time
        && d.updatedAt == request.time
        && (d.name == '' || validName(d.name))
        && validPhone(d.get('phone', null))
        && d.get('profileImage', null) == null;
    }

    // CUSTOMER (self) scope: profile fields only.
    function validProfileUpdate() {
      let data = request.resource.data;
      let changed = data.diff(resource.data).affectedKeys();
      return changed.hasOnly(['name', 'phone', 'profileImage', 'updatedAt'])
        && data.updatedAt == request.time
        && (!changed.hasAny(['name']) || validName(data.name))
        && (!changed.hasAny(['phone']) || validPhone(data.phone))
        && (!changed.hasAny(['profileImage']) || validProfileImage(data.profileImage));
    }

    // PLATFORM scope: role / shop assignment / activation of ANOTHER user.
    // shopAdmin needs an existing shop; customer and superadmin have none.
    function validAdminUserUpdate() {
      let d = request.resource.data;
      let changed = d.diff(resource.data).affectedKeys();
      let sid = d.get('shopId', null);
      return changed.hasOnly(['role', 'shopId', 'isActive', 'updatedAt'])
        && d.updatedAt == request.time
        && d.role in ['superadmin', 'shopAdmin', 'customer']
        && d.isActive is bool
        && ((d.role == 'shopAdmin' && sid is string && sid.size() > 0
              && exists(shopPath(sid)))
            || (d.role != 'shopAdmin' && sid == null));
    }

    match /users/{uid} {
      // Self (also while inactive, so the app can show "account disabled")
      // or superadmin. Shop admins see customers only through the booking
      // snapshots (customerNameSnapshot / customerPhoneSnapshot).
      allow read: if isSelf(uid) || isSuperadmin();

      allow create: if validSelfCreate(uid);

      // Self: profile fields while active. Superadmin: role/shopId/isActive
      // of OTHER users only (a superadmin cannot demote or disable
      // themselves, which avoids locking the platform out).
      allow update: if (isSelf(uid)
                         && resource.data.get('isActive', false) == true
                         && validProfileUpdate())
                    || (!isSelf(uid) && isSuperadmin() && validAdminUserUpdate());

      allow delete: if false;
    }

    // --- Venue field validators (mirror: lib/core/constants/venue_policy.dart)

    function optText(v, max) {
      return v == null || (v is string && v.size() <= max);
    }

    // Map pin: both or neither, WGS84 degrees in range.
    // MIRRORED in VenuePolicy.isValidLocation.
    function validLocation(d) {
      let lat = d.get('latitude', null);
      let lng = d.get('longitude', null);
      return (lat == null && lng == null)
        || (lat is number && lng is number
            && lat >= -90 && lat <= 90
            && lng >= -180 && lng <= 180);
    }

    function optStringList(v, max) {
      return v is list && v.size() <= max;
    }

    // --- shops/{shopId} ---------------------------------------------------
    // Public, customer-safe profile. Admin-only fields live in the private
    // subdoc because rules cannot hide individual fields of a readable doc.
    // PLATFORM scope: only the superadmin writes shops (the shop-profile
    // phase may open profile fields to the shop's admins later). When the
    // superadmin changes status or isListed, the same batch updates the
    // shop's stadiums' isPublished (see stadiums below).

    function shopKeys() {
      return ['name', 'slug', 'description', 'logo', 'coverImage', 'phone',
              'email', 'address', 'township', 'city', 'latitude', 'longitude',
              'status', 'isListed', 'approvedAt', 'createdAt', 'updatedAt'];
    }

    function validShopShape(d) {
      return d.keys().hasOnly(shopKeys())
        && d.keys().hasAll(['name', 'status', 'isListed', 'createdAt',
                            'updatedAt'])
        && validName(d.name)
        && optText(d.get('slug', null), 80)
        && optText(d.get('description', null), 1000)
        && optText(d.get('logo', null), 2048)
        && optText(d.get('coverImage', null), 2048)
        && validPhone(d.get('phone', null))
        && optText(d.get('email', null), 254)
        && optText(d.get('address', null), 200)
        && optText(d.get('township', null), 80)
        && optText(d.get('city', null), 80)
        && validLocation(d)
        && d.status in ['pending', 'active', 'suspended', 'rejected', 'inactive']
        && d.isListed is bool
        && (d.get('approvedAt', null) == null || d.approvedAt is timestamp)
        && d.updatedAt == request.time;
    }

    function shopPrivateKeys() {
      return ['shopId', 'ownerName', 'ownerPhone', 'adminIds', 'approvedBy',
              'suspendedAt', 'suspendedReason', 'updatedAt'];
    }

    function validShopPrivate(shopId, docId) {
      let d = request.resource.data;
      return docId == 'details'
        && d.keys().hasOnly(shopPrivateKeys())
        && d.shopId == shopId
        && optText(d.get('ownerName', null), 80)
        && validPhone(d.get('ownerPhone', null))
        && d.get('adminIds', []) is list
        && (d.get('approvedBy', null) == null || d.approvedBy is string)
        && (d.get('suspendedAt', null) == null || d.suspendedAt is timestamp)
        && validReason(d.get('suspendedReason', null))
        && d.updatedAt == request.time;
    }

    match /shops/{shopDocId} {
      allow read: if (signedIn()
                      && resource.data.status == 'active'
                      && resource.data.isListed == true)
        || isSuperadmin()
        || isAdminOfShop(shopDocId);

      allow create: if isSuperadmin()
        && validShopShape(request.resource.data)
        && request.resource.data.createdAt == request.time;
      allow update: if isSuperadmin()
        && validShopShape(request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt;
      // Shops are never deleted: set status 'inactive' instead.
      allow delete: if false;

      match /private/{docId} {
        allow read: if isSuperadmin() || isAdminOfShop(shopDocId);
        allow create, update: if isSuperadmin()
          && validShopPrivate(shopDocId, docId);
        allow delete: if false;
      }

      // SHOP scope blacklist: a shop's admins stop a customer (e.g. repeated
      // no-shows) from making NEW bookings at this shop only. Existing
      // bookings are untouched. Doc id = the customer's uid. The customer
      // may read their own entry (booking pre-check); validNewBooking
      // enforces it. Immutable: delete to lift, re-create to change.
      match /blacklist/{customerId} {
        allow get: if isSuperadmin()
          || isAdminOfShop(shopDocId)
          || (isSelf(customerId) && isActiveUser());
        allow list: if isSuperadmin() || isAdminOfShop(shopDocId);
        allow create: if (isAdminOfShop(shopDocId) || isSuperadmin())
          && validBlacklistEntry(shopDocId, customerId);
        allow update: if false;
        allow delete: if isAdminOfShop(shopDocId) || isSuperadmin();
      }
    }

    function blacklistKeys() {
      return ['shopId', 'customerId', 'customerNameSnapshot',
              'customerPhoneSnapshot', 'reason', 'note', 'createdBy',
              'createdAt'];
    }

    // Name/phone are display snapshots taken from the customer's booking
    // (admins can't read users/{uid}); they grant nothing.
    // Mirror: BlacklistPolicy (lib/core/constants/blacklist_policy.dart).
    function validBlacklistEntry(shopId, customerId) {
      let d = request.resource.data;
      return d.keys().hasOnly(blacklistKeys())
        && d.keys().hasAll(['shopId', 'customerId', 'customerNameSnapshot',
                            'reason', 'createdBy', 'createdAt'])
        && d.shopId == shopId
        && d.customerId == customerId
        && customerId != request.auth.uid
        && validName(d.customerNameSnapshot)
        && validPhone(d.get('customerPhoneSnapshot', null))
        && d.reason in ['noShow', 'other']
        && optText(d.get('note', null), 200)
        && d.createdBy == request.auth.uid
        && d.createdAt == request.time;
    }

    // --- stadiums/{stadiumId} ---------------------------------------------
    // INVARIANT (client-maintained, no triggers on Spark):
    //   isPublished == shop.status == 'active' && shop.isListed && stadium.isActive
    // Checked whenever isActive or isPublished changes: on shop-admin writes
    // and on the superadmin's shop-status batch (which updates every stadium
    // of the shop). A stale isPublished (e.g. a stadium created while that
    // batch was committing) can only affect discovery: the booking create
    // rule re-checks the shop and the stadium itself, so it can never allow
    // a booking at a suspended/unlisted shop.
    // minHourlyPrice is client-maintained by the shop admin when saving
    // courts, display only. Customer list queries MUST include
    // where('isPublished', '==', true).
    //
    // SLOT GRID (booking integrity): slot lock ids sit on a grid counted
    // from openMinute. openMinute is a whole hour and court slotMinutes is
    // 30 or 60 and immutable, so editing opening hours never moves the
    // grid and a new booking's lock docs always collide with existing ones.
    // Mirror: VenuePolicy (lib/core/constants/venue_policy.dart).

    function stadiumData(stadiumId) {
      return get(stadiumPath(stadiumId)).data;
    }

    function stadiumKeys() {
      return ['shopId', 'name', 'description', 'address', 'township', 'city',
              'latitude', 'longitude', 'images', 'facilities', 'openMinute',
              'closeMinute', 'timeZone', 'isActive', 'isPublished',
              'minHourlyPrice', 'surfaces', 'freeCancelHours',
              'cancellationNote',
              'createdAt', 'updatedAt'];
    }

    function facilityKeys() {
      return ['parking', 'shower', 'changingRoom', 'drinkingWater',
              'floodLights', 'seating', 'restroom', 'cafe', 'equipmentRental'];
    }

    // Mirror: CourtSurface (lib/core/constants/domain_enums.dart).
    function surfaceKeys() {
      return ['artificialTurf', 'sportsTile', 'rubber', 'wood', 'concrete'];
    }

    function validOpeningHours(d) {
      return d.openMinute is int && d.closeMinute is int
        && d.openMinute >= 0
        && d.openMinute % 60 == 0
        && d.closeMinute > d.openMinute
        && d.closeMinute <= 1440;
    }

    function validStadiumShape(d) {
      return d.keys().hasOnly(stadiumKeys())
        && d.keys().hasAll(['shopId', 'name', 'openMinute', 'closeMinute',
                            'timeZone', 'isActive', 'isPublished',
                            'createdAt', 'updatedAt'])
        && d.shopId is string
        && validName(d.name)
        && optText(d.get('description', null), 1000)
        && optText(d.get('address', null), 200)
        && optText(d.get('township', null), 80)
        && optText(d.get('city', null), 80)
        && validLocation(d)
        && optStringList(d.get('images', []), 10)
        && optStringList(d.get('facilities', []), 9)
        && d.get('facilities', []).hasOnly(facilityKeys())
        && validOpeningHours(d)
        && d.timeZone == 'Asia/Yangon'
        && d.isActive is bool
        && d.isPublished is bool
        && (d.get('minHourlyPrice', null) == null
            || (d.minHourlyPrice is int && d.minHourlyPrice >= 0))
        && optStringList(d.get('surfaces', []), 5)
        && d.get('surfaces', []).hasOnly(surfaceKeys())
        && validFreeCancelHours(d.get('freeCancelHours', null))
        && optText(d.get('cancellationNote', null), 300)
        && d.updatedAt == request.time;
    }

    // Cancellation policy: hours before start a customer can cancel for a
    // full refund, or null (no stated policy). Bookings copy it.
    // Mirror: CancellationPolicy (lib/core/constants/cancellation_policy.dart).
    function validFreeCancelHours(v) {
      return v == null || v in [0, 2, 6, 12, 24, 48];
    }

    // Mirror: VenuePolicy.isPublished.
    function stadiumPublished(shop, d) {
      return shop.status == 'active'
        && shop.isListed == true
        && d.isActive == true;
    }

    // SHOP scope: the admin's own shop only; shopId never changes.
    function shopAdminCreatesStadium() {
      let d = request.resource.data;
      return isAdminOfShop(d.shopId)
        && validStadiumShape(d)
        && d.createdAt == request.time
        && d.isPublished == stadiumPublished(get(shopPath(d.shopId)).data, d);
    }

    function shopAdminUpdatesStadium() {
      let d = request.resource.data;
      return isAdminOfShop(resource.data.shopId)
        && validStadiumShape(d)
        && d.shopId == resource.data.shopId
        && d.createdAt == resource.data.createdAt
        && (!changedKeys().hasAny(['isActive', 'isPublished'])
            || d.isPublished == stadiumPublished(getAfter(shopPath(d.shopId)).data, d));
    }

    // A court save also refreshes the stadium's display-only court summary.
    // Keep this update narrow so older stadium documents with legacy fields
    // can still receive court summary updates without passing the full shape
    // validator used by stadium edits.
    function shopAdminUpdatesCourtSummary() {
      let d = request.resource.data;
      let changed = d.diff(resource.data).affectedKeys();
      return isAdminOfShop(resource.data.shopId)
        && d.shopId == resource.data.shopId
        && changed.hasOnly(['minHourlyPrice', 'surfaces', 'updatedAt'])
        && changed.hasAll(['updatedAt'])
        && d.updatedAt == request.time
        && (d.get('minHourlyPrice', null) == null
            || (d.minHourlyPrice is int && d.minHourlyPrice >= 0))
        && d.get('surfaces', []) is list
        && d.get('surfaces', []).hasOnly(surfaceKeys());
    }

    // PLATFORM scope: re-sync isPublished in the same batch that changes the
    // shop's status / isListed (getAfter sees the new shop state).
    function superadminSyncsStadium() {
      let d = request.resource.data;
      return isSuperadmin()
        && changedKeys().hasOnly(['isPublished', 'updatedAt'])
        && d.updatedAt == request.time
        && d.isPublished == stadiumPublished(getAfter(shopPath(resource.data.shopId)).data, d);
    }

    match /stadiums/{stadiumId} {
      allow read: if (signedIn() && resource.data.isPublished == true)
        || isSuperadmin()
        || isAdminOfShop(resource.data.shopId);
      allow create: if shopAdminCreatesStadium();
      allow update: if shopAdminUpdatesStadium()
        || shopAdminUpdatesCourtSummary()
        || superadminSyncsStadium();
      // Never deleted (bookings reference it): set isActive false instead.
      allow delete: if false;

      // Courts: visibility follows the parent stadium via one get() per
      // request. Customers must query where('isActive', '==', true).
      match /courts/{courtId} {
        allow read: if (signedIn()
                        && resource.data.isActive == true
                        && stadiumData(stadiumId).isPublished == true)
          || isSuperadmin()
          || isAdminOfShop(stadiumData(stadiumId).shopId);
        // SHOP scope. shopId comes from the parent stadium. slotMinutes is
        // fixed at creation (see SLOT GRID above).
        allow create: if isAdminOfShop(stadiumData(stadiumId).shopId)
          && request.resource.data.shopId == stadiumData(stadiumId).shopId
          && validCourtShape(request.resource.data, stadiumId)
          && request.resource.data.createdAt == request.time;
        allow update: if isAdminOfShop(resource.data.shopId)
          && validCourtShape(request.resource.data, stadiumId)
          && request.resource.data.shopId == resource.data.shopId
          && request.resource.data.slotMinutes == resource.data.slotMinutes
          && request.resource.data.createdAt == resource.data.createdAt;
        // Never deleted (bookings reference it): set isActive false instead.
        allow delete: if false;

        // Slot lock docs: {yyyy-MM-dd}_{startMinute:4 digits}. No personal
        // data, so any signed-in user may read them (availability).
        match /slots/{slotId} {
          allow read: if signedIn();
          allow create: if validNewSlot(stadiumId, courtId, slotId);
          // THE lock: an existing slot can never be overwritten.
          allow update: if false;
          allow delete: if isActiveUser()
            && (bookedSlotReleased() || blockedSlotReleased());
        }
      }
    }

    function courtKeys() {
      return ['shopId', 'stadiumId', 'name', 'description', 'surfaceType',
              'capacity', 'hourlyPrice', 'currency', 'slotMinutes', 'images',
              'isActive', 'createdAt', 'updatedAt'];
    }

    // Mirror: VenuePolicy (allowedSlotMinutes, maxHourlyPrice, maxCapacity).
    function validCourtShape(d, stadiumId) {
      return d.keys().hasOnly(courtKeys())
        && d.keys().hasAll(['shopId', 'stadiumId', 'name', 'hourlyPrice',
                            'currency', 'slotMinutes', 'isActive',
                            'createdAt', 'updatedAt'])
        && d.stadiumId == stadiumId
        && validName(d.name)
        && optText(d.get('description', null), 1000)
        && optText(d.get('surfaceType', null), 40)
        && (d.get('capacity', null) == null
            || (d.capacity is int && d.capacity >= 1 && d.capacity <= 100))
        && d.hourlyPrice is int
        && d.hourlyPrice >= 0
        && d.hourlyPrice <= 10000000
        && d.currency == 'MMK'
        && d.slotMinutes in [30, 60]
        && optStringList(d.get('images', []), 10)
        && d.isActive is bool
        && d.updatedAt == request.time;
    }

    function slotKeys() {
      return ['shopId', 'stadiumId', 'courtId', 'date', 'startMinute',
              'endMinute', 'kind', 'refId', 'createdBy', 'createdAt'];
    }

    function validNewSlot(stadiumId, courtId, slotId) {
      let s = request.resource.data;
      let k = slotKeys();
      return isActiveUser()
        && s.keys().hasOnly(k)
        && s.keys().hasAll(k)
        && s.stadiumId == stadiumId
        && s.courtId == courtId
        && s.shopId is string
        && s.refId is string && s.refId.size() > 0
        && isDateKey(s.date)
        && s.startMinute is int && s.endMinute is int
        && s.startMinute >= 0 && s.startMinute < 1440
        && slotId == slotKey(s.date, s.startMinute)
        && s.createdBy == request.auth.uid
        && s.createdAt == request.time
        && ((s.kind == 'booked'
              && !exists(bookingPath(s.refId))
              && slotMatchesBooking(s, getAfter(bookingPath(s.refId)).data))
            || (s.kind == 'blocked'
              && (isSuperadmin() || isAdminOfShop(s.shopId))
              && slotMatchesBlock(s, getAfter(blockPath(s.refId)).data)));
    }

    // The referenced booking is created in this same request, by this
    // customer, and the slot lies on its grid.
    function slotMatchesBooking(s, b) {
      return b.customerId == request.auth.uid
        && b.status == 'pending'
        && b.bookingDate == s.date
        && slotInside(s, b);
    }

    function slotMatchesBlock(s, x) {
      return x.date == s.date && slotInside(s, x);
    }

    function slotInside(s, x) {
      return x.shopId == s.shopId
        && x.stadiumId == s.stadiumId
        && x.courtId == s.courtId
        && s.startMinute >= x.startMinute
        && s.startMinute < x.endMinute
        && (s.startMinute - x.startMinute) % x.slotMinutes == 0
        && s.endMinute == s.startMinute + x.slotMinutes;
    }

    // A booked slot is released only when its booking is (now) cancelled or
    // rejected, by the booking's customer or staff of its shop.
    function bookedSlotReleased() {
      return resource.data.kind == 'booked'
        && bookingReleasable(getAfter(bookingPath(resource.data.refId)).data);
    }

    function bookingReleasable(b) {
      return b.status in ['cancelled', 'rejected']
        && (b.customerId == request.auth.uid
            || isSuperadmin()
            || isAdminOfShop(b.shopId));
    }

    // A blocked slot is released together with (or after) its block doc.
    function blockedSlotReleased() {
      return resource.data.kind == 'blocked'
        && (isSuperadmin() || isAdminOfShop(resource.data.shopId))
        && !existsAfter(blockPath(resource.data.refId));
    }

    // --- bookings/{bookingId} ---------------------------------------------

    function bookingKeys() {
      return ['shopId', 'customerId', 'stadiumId', 'courtId', 'bookingDate',
              'startMinute', 'endMinute', 'slotMinutes', 'startAt', 'endAt',
              'pricePerHour', 'totalPrice', 'currency', 'status',
              'paymentStatus', 'customerNameSnapshot', 'customerPhoneSnapshot',
              'stadiumNameSnapshot', 'courtNameSnapshot', 'createdAt',
              'updatedAt'];
    }

    // Everything the old booking Cloud Function validated.
    //
    // EXPRESSION BUDGET: a request may evaluate at most 1,000 expressions
    // (all its writes together). A 4-slot booking (1 booking + 4 slot docs)
    // is close to that limit, so each document is fetched and each key list
    // built once here (let), not once per helper call. firestore-tests/
    // "a valid 4-slot booking succeeds" guards this; run it after editing.
    function validNewBooking(bookingId) {
      let b = request.resource.data;
      let u = me();
      let court = get(courtPath(b.stadiumId, b.courtId)).data;
      let required = bookingKeys();
      return u.get('isActive', false) == true
        && u.get('role', '') == 'customer'
        && b.keys().hasAll(required)
        // Optional keys: freeCancelHours only.
        && b.keys().removeAll(required).hasOnly(['freeCancelHours'])
        && b.status == 'pending'
        && b.paymentStatus == 'unpaid'
        && b.currency == 'MMK'
        && b.createdAt == request.time
        && b.updatedAt == request.time
        && newBookingCustomerOk(b, u)
        && newBookingTimesOk(b)
        && newBookingVenueOk(b, court,
             get(stadiumPath(b.stadiumId)).data,
             get(shopPath(b.shopId)).data)
        && newBookingPriceOk(b, court)
        // Not blacklisted by this shop (b.shopId is checked against the
        // court/stadium/shop above).
        && !exists(blacklistPath(b.shopId, request.auth.uid))
        && allSlotsHeld(b, b.bookingDate, 'booked', bookingId);
    }

    // Snapshots must match the caller's own profile (no impersonation).
    function newBookingCustomerOk(b, u) {
      return b.customerId == request.auth.uid
        && validName(u.name)
        && b.customerNameSnapshot == u.name
        && b.customerPhoneSnapshot == u.get('phone', null);
    }

    // Future, at most 30 days ahead, startAt/endAt consistent with the date.
    function newBookingTimesOk(b) {
      return validInstants(b.bookingDate, b)
        && b.startAt > request.time
        && b.startAt < request.time + duration.value(30, 'd');
    }

    function newBookingVenueOk(b, court, stadium, shop) {
      return court.isActive == true
        && court.shopId == b.shopId
        && court.stadiumId == b.stadiumId
        && stadium.isActive == true
        && stadium.shopId == b.shopId
        && stadium.get('timeZone', 'Asia/Yangon') == 'Asia/Yangon'
        && shop.status == 'active'
        && shop.isListed == true
        && b.stadiumNameSnapshot == stadium.name
        && b.courtNameSnapshot == court.name
        // The customer agrees to the policy the stadium has right now.
        && b.get('freeCancelHours', null) == stadium.get('freeCancelHours', null)
        && validWindow(b, stadium, courtSlotMinutes(court));
    }

    // totalPrice == floor((hourlyPrice * minutes + 30) / 60), written as
    // 60 * t <= x < 60 * (t + 1) to stay in integer arithmetic.
    // Mirror: Money.totalPrice (Dart).
    function newBookingPriceOk(b, court) {
      return court.hourlyPrice is int
        && court.hourlyPrice >= 0
        && b.pricePerHour == court.hourlyPrice
        && b.totalPrice is int
        && priceMatches(b.totalPrice,
             court.hourlyPrice * (b.endMinute - b.startMinute) + 30);
    }

    function priceMatches(total, scaled) {
      return total * 60 <= scaled && scaled < (total + 1) * 60;
    }

    function changedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    function statusMove(fromStatuses, toStatus) {
      return resource.data.status in fromStatuses
        && request.resource.data.status == toStatus;
    }

    function canManageBooking() {
      return isSuperadmin() || isAdminOfShop(resource.data.shopId);
    }

    // CUSTOMER: cancel own pending/confirmed booking before it starts; the
    // same request must delete all its slot docs.
    function customerCancels() {
      let b = resource.data;
      let n = request.resource.data;
      return role() == 'customer'
        && b.customerId == request.auth.uid
        && statusMove(['pending', 'confirmed'], 'cancelled')
        && changedKeys().hasOnly(['status', 'updatedAt', 'cancelledAt', 'cancelReason'])
        && n.cancelledAt == request.time
        && validReason(n.get('cancelReason', null))
        && request.time < b.startAt
        && allSlotsFreed(b, b.bookingDate);
    }

    function staffConfirms() {
      return canManageBooking()
        && statusMove(['pending'], 'confirmed')
        && changedKeys().hasOnly(['status', 'updatedAt']);
    }

    // Reject also frees the slots (same request).
    function staffRejects() {
      return canManageBooking()
        && statusMove(['pending', 'confirmed'], 'rejected')
        && changedKeys().hasOnly(['status', 'updatedAt', 'cancelReason'])
        && validReason(request.resource.data.get('cancelReason', null))
        && allSlotsFreed(resource.data, resource.data.bookingDate);
    }

    // Completed bookings keep their slots (the time is in the past).
    function staffCompletes() {
      return canManageBooking()
        && statusMove(['confirmed'], 'completed')
        && changedKeys().hasOnly(['status', 'updatedAt'])
        && request.time >= resource.data.startAt;
    }

    // Payment is staff-only: unpaid -> pending -> paid, paid -> refunded.
    function staffChangesPayment() {
      let was = resource.data.paymentStatus;
      let now = request.resource.data.paymentStatus;
      return canManageBooking()
        && changedKeys().hasOnly(['paymentStatus', 'updatedAt'])
        && ((was == 'unpaid' && now == 'pending')
            || (was == 'pending' && now == 'paid')
            || (was == 'paid' && now == 'refunded'));
    }

    match /bookings/{bookingId} {
      allow read: if (signedIn()
                      && resource.data.customerId == request.auth.uid
                      && isActiveUser())
        || isSuperadmin()
        || isAdminOfShop(resource.data.shopId);

      allow create: if validNewBooking(bookingId);

      // Price, times, court, shop and customer are immutable: every branch
      // whitelists the keys it may change.
      allow update: if isActiveUser()
        && request.resource.data.updatedAt == request.time
        && (customerCancels()
            || staffConfirms()
            || staffRejects()
            || staffCompletes()
            || staffChangesPayment());

      allow delete: if false;
    }

    // --- blocked_slots/{blockedSlotId} ------------------------------------
    // Admin-only. Customers see blocked time only through the slot docs.
    // One block covers at most 4 slots (same cap as bookings); longer
    // closures are several block docs (Phase 11 UI). Immutable: delete and
    // re-create to change.

    function blockKeys() {
      return ['shopId', 'stadiumId', 'courtId', 'date', 'startMinute',
              'endMinute', 'slotMinutes', 'startAt', 'endAt', 'reason', 'note',
              'createdBy', 'createdAt', 'updatedAt'];
    }

    function validNewBlock(blockedSlotId) {
      let x = request.resource.data;
      return (isSuperadmin() || isAdminOfShop(x.shopId))
        && x.keys().hasOnly(blockKeys())
        && x.keys().hasAll(blockKeys())
        && x.reason in ['maintenance', 'privateEvent', 'cleaning',
                        'tournament', 'temporaryClosure', 'other']
        && validReason(x.note)
        && x.createdBy == request.auth.uid
        && x.createdAt == request.time
        && x.updatedAt == request.time
        && validInstants(x.date, x)
        && blockVenueOk(x,
             get(courtPath(x.stadiumId, x.courtId)).data,
             get(stadiumPath(x.stadiumId)).data)
        && allSlotsHeld(x, x.date, 'blocked', blockedSlotId);
    }

    function blockVenueOk(x, court, stadium) {
      return court.shopId == x.shopId
        && court.stadiumId == x.stadiumId
        && stadium.shopId == x.shopId
        && validWindow(x, stadium, courtSlotMinutes(court));
    }

    match /blocked_slots/{blockedSlotId} {
      allow read: if isSuperadmin() || isAdminOfShop(resource.data.shopId);
      allow create: if validNewBlock(blockedSlotId);
      allow update: if false;
      allow delete: if (isSuperadmin() || isAdminOfShop(resource.data.shopId))
        && allSlotsFreed(resource.data, resource.data.date);
    }

    // --- notifications/{bookingId}_{type} ---------------------------------
    // In-app notifications (Spark plan: no server can send them). The client
    // writes one right after a booking event; every field must match the
    // booking as stored, and the id is fixed per event, so a user can only
    // report real events of bookings they are part of, once each.
    //   customer -> shop     : bookingRequested (pending), bookingCancelled
    //   shop staff -> customer: bookingConfirmed, bookingRejected
    // Access budget: users/{uid} + bookings/{id} = 2.

    function notificationKeys() {
      return ['audience', 'recipientId', 'shopId', 'bookingId', 'type',
              'actorId', 'customerNameSnapshot', 'stadiumNameSnapshot',
              'courtNameSnapshot', 'bookingDate', 'startMinute', 'endMinute',
              'reason', 'isRead', 'createdAt'];
    }

    function validNewNotification(notificationId) {
      let n = request.resource.data;
      return isActiveUser()
        && n.keys().hasOnly(notificationKeys())
        && n.keys().hasAll(notificationKeys())
        && n.bookingId is string
        && n.type is string
        && notificationId == n.bookingId + '_' + n.type
        && n.actorId == request.auth.uid
        && n.isRead == false
        && n.createdAt == request.time
        && notificationMatchesBooking(n, get(bookingPath(n.bookingId)).data);
    }

    function notificationMatchesBooking(n, b) {
      return n.shopId == b.shopId
        && n.customerNameSnapshot == b.customerNameSnapshot
        && n.stadiumNameSnapshot == b.stadiumNameSnapshot
        && n.courtNameSnapshot == b.courtNameSnapshot
        && n.bookingDate == b.bookingDate
        && n.startMinute == b.startMinute
        && n.endMinute == b.endMinute
        && n.reason == b.get('cancelReason', null)
        && notificationEventOk(n, b);
    }

    // Mirror: NotificationType (lib/core/constants/domain_enums.dart).
    function notificationEventOk(n, b) {
      return (n.type == 'bookingRequested' && b.status == 'pending'
              && customerToShop(n, b))
        || (n.type == 'bookingCancelled' && b.status == 'cancelled'
              && customerToShop(n, b))
        || (n.type == 'bookingConfirmed' && b.status == 'confirmed'
              && staffToCustomer(n, b))
        || (n.type == 'bookingRejected' && b.status == 'rejected'
              && staffToCustomer(n, b));
    }

    function customerToShop(n, b) {
      return b.customerId == request.auth.uid
        && n.audience == 'shop'
        && n.recipientId == b.shopId;
    }

    function staffToCustomer(n, b) {
      return (isSuperadmin() || isAdminOfShop(b.shopId))
        && n.audience == 'customer'
        && n.recipientId == b.customerId;
    }

    function isNotificationRecipient(n) {
      return (n.audience == 'customer'
              && isSelf(n.recipientId)
              && isActiveUser())
        || (n.audience == 'shop' && isAdminOfShop(n.recipientId));
    }

    match /notifications/{notificationId} {
      allow read: if isNotificationRecipient(resource.data);

      allow create: if validNewNotification(notificationId);

      // Only "mark as read".
      allow update: if isNotificationRecipient(resource.data)
        && changedKeys().hasOnly(['isRead', 'readAt'])
        && request.resource.data.isRead == true
        && request.resource.data.readAt == request.time;

      allow delete: if false;
    }

    // --- announcements/{announcementId} -----------------------------------
    // PLATFORM scope. Create-only, by an active superadmin; never edited or
    // deleted. The superadmin lists them all; any other active user may read
    // the ones whose audience covers their role (list queries must then
    // filter on `audience`).

    function validNewAnnouncement() {
      let a = request.resource.data;
      return isSuperadmin()
        && a.keys().hasOnly(['title', 'body', 'audience', 'createdBy', 'createdAt'])
        && a.keys().hasAll(['title', 'body', 'audience', 'createdBy', 'createdAt'])
        && a.title is string && a.title.size() > 0 && a.title.size() <= 60
        && a.body is string && a.body.size() > 0 && a.body.size() <= 300
        && a.audience in ['everyone', 'customers', 'shopAdmins']
        && a.createdBy == request.auth.uid
        && a.createdAt == request.time;
    }

    function canReadAnnouncement(a) {
      return isSuperadmin()
        || (isActiveUser()
            && (a.audience == 'everyone'
                || (a.audience == 'customers' && role() == 'customer')
                || (a.audience == 'shopAdmins' && isShopAdmin())));
    }

    match /announcements/{announcementId} {
      allow read: if canReadAnnouncement(resource.data);
      allow create: if validNewAnnouncement();
      allow update, delete: if false;
    }

    // --- players/{uid} ---------------------------------------------------
    // CUSTOMER (self) scope, no shopId: a public player card (display name,
    // position, skill level, short bio; no contact details). Read by any
    // active user (match invites, find a game); written only by its owner.
    // displayName must equal the owner's users/{uid}.name, so nobody can
    // pose as someone else. Mirror: lib/core/constants/player_policy.dart.

    function validPlayer() {
      let d = request.resource.data;
      return d.keys().hasOnly(['displayName', 'position', 'skillLevel',
                               'bio', 'updatedAt'])
        && d.keys().hasAll(['displayName', 'position', 'skillLevel',
                            'updatedAt'])
        && validName(d.displayName)
        && d.displayName == me().get('name', '')
        && d.position in ['goalkeeper', 'defender', 'midfielder', 'forward',
                          'anywhere']
        && d.skillLevel in ['beginner', 'casual', 'intermediate', 'advanced']
        && optText(d.get('bio', null), 200)
        && d.updatedAt == request.time;
    }

    match /players/{uid} {
      allow read: if isActiveUser();
      allow create, update: if isSelf(uid) && isActiveUser() && validPlayer();
      allow delete: if isSelf(uid) && isActiveUser();
    }

    // --- Everything else: deny --------------------------------------------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
